# Copy to .env (gitignored) and fill in real values. Read by
# server/core/config.py via pydantic-settings. Run uvicorn from the repo
# root (as documented in server/main.py) so this relative path resolves.

# asyncpg driver — SQLAlchemy's async engine needs the "+asyncpg" suffix.
DATABASE_URL=postgresql+asyncpg://study_os_app:CHANGE_ME@localhost:5432/study_os

# Comma-separated allowed CORS origins. Defaults to "*" (every origin) if
# unset — fine for local dev, set this to your real frontend origin(s)
# before deployment, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# The Google Cloud "Web application" OAuth client id (NOT the Android
# client's id — that one never appears in config on either side, see
# server/core/config.py). Required for POST /api/auth/google to work at
# all; leave unset if Google Sign-In isn't configured for this environment.
# GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Hosted AI tier ("Study OS AI", paid in app credits — see
# docs/COST_AND_CREDITS.md) — Study OS's OWN pooled provider keys, distinct
# from a user's per-user BYOK key. The server uses HOSTED_DEFAULT_PROVIDER's
# key; students can't choose. With no key for it, the hosted tier says it
# isn't available rather than failing silently.
# HOSTED_DEFAULT_PROVIDER=deepseek
# HOSTED_DEEPSEEK_API_KEY=sk-...
# HOSTED_ANTHROPIC_API_KEY=sk-ant-...
# HOSTED_OPENAI_API_KEY=sk-...
# The hidden allowance: the most one student's hosted calls may cost Study
# OS in a month (US dollars). Raise it once real payments exist.
# HOSTED_MONTHLY_COST_CAP_USD=3

# "mock" (default) is the only implemented payment provider until a real
# processor (Stripe/Paystack/etc.) is chosen — see
# server/domains/billing/payment_provider.py. Do not set this to anything
# else without first implementing that provider's class.
# PAYMENT_PROVIDER=mock

# Only used by billing/pricing.py's compute_charge for internal reports
# since 2026-10-27; students pay fixed credits per feature
# (billing/credits.py), never a markup on tokens.
# HOSTED_MARKUP_PERCENT=30
# HOSTED_INFRA_SURCHARGE_PERCENT=0

# Heavy-engine limits (OCR, Whisper, PDF, charts) — see
# server/core/runtime_env.py. "auto" (the default) sizes them from the
# machine's CPUs and RAM, using about HALF the CPUs: on a shared VPS
# (Contabo) the vCPUs are shared with other customers, so maxing every core
# gets slower, not faster. The resolved values are logged on every start
# ("engine limits: ..." in `journalctl -u study-os`).
# HEAVY_ENGINE_WORKERS=auto   # heavy jobs at once (auto: CPUs/2, 1-4); the rest queue
# ENGINE_THREADS=1            # native threads per heavy job
# LOCAL_MODEL_THREADS=auto    # torch threads for the optional local LLM (auto: CPUs/2, 1-8)
# LOCAL_MODEL_MAX_CONCURRENCY=1
# HEAVY_ENGINE_NICE=10        # lower Linux priority for heavy work; 0 disables

# Disk cleanup (server/workers/cleanup.py) — runs inside the app a minute
# after start, then every CLEANUP_INTERVAL_HOURS (0 turns it off). Chat
# uploads are only needed briefly; chat-made pictures/PDFs are only linked
# from chat history on the phone, which can keep its own copy (the app asks
# the student first). Studio PDFs and project indexes are never aged out.
# CLEANUP_INTERVAL_HOURS=6
# UPLOAD_RETENTION_HOURS=24
# GENERATED_RETENTION_DAYS=14   # the app tells students "about two weeks"

# "Forgot password" emails (server/core/email.py). Without a key the app says
# reset by email isn't set up. EMAIL_FROM must use a domain verified in
# Resend; onboarding@resend.dev only delivers to the Resend account owner.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Study OS <no-reply@your-domain>

# Go deeper (server/domains/research/): real videos, books and papers.
# YouTube Data API v3 key (Google Cloud console → APIs & Services →
# Credentials; enable "YouTube Data API v3"). Without it Go deeper still
# finds books, papers and articles, and pasted YouTube links still play in
# the app, but it can't search for videos. Free quota: ~100 searches a day.
# YOUTUBE_API_KEY=AIza...
# Optional: OpenAlex works without a key; one raises its rate limit.
# OPENALEX_API_KEY=
